# PixelLab API token — get it from your account at https://www.pixellab.ai/
# Used ONLY for dev-time pixel-art generation via the pixellab MCP server (.mcp.json).
# Never referenced by app code; never shipped to the client bundle.
# NOTE: set this in the shell environment that LAUNCHES Claude Code —
# a .env file is not auto-loaded by the MCP config.
PIXELLAB_SECRET=

# ElevenLabs API key — https://elevenlabs.io/ account -> API keys.
# Dev-time generation of the loop music (assets/audio/theme.mp3) and the
# whip/shatter/reopen/enemy-die SFX via the audio-pipeline skill.
# Never referenced by app code; never shipped to the client bundle.
ELEVENLABS_API_KEY=

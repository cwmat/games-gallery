{
  "name": "games-gallery",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gates": "pnpm lint && pnpm typecheck && pnpm test",
    "gates:full": "pnpm gates && pnpm build",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.0",
    "vitest": "^4.0.0"
  }
}
